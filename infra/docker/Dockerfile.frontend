# Frontend image. Two stages so the runtime carries static files and a web
# server, not Node and node_modules.
FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# The demo snapshots are a build input: if a page reaches for data the export
# did not produce, the build fails here rather than on the deployed link.
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/out /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
